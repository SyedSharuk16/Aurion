# Copy to .env and fill. .env is gitignored and is the ONLY source of secrets.
# No secret may appear in config.yaml, code, logs, or Telegram messages.
#
# Put the value straight after `=` with no space, and delete the trailing `# comment`
# on any line you edit. The runtime strips both and warns, but docker compose's
# env_file parser keeps them -- so a file left uncorrected works one way and fails the
# other.

# --- Broker / data ---------------------------------------------------------
AURION_OANDA_API_TOKEN=
AURION_OANDA_ACCOUNT_ID=
AURION_OANDA_ENV=practice            # practice | live  (data-only; no order endpoints are used)

# --- Telegram -------------------------------------------------------------
AURION_TELEGRAM_BOT_TOKEN=
AURION_TELEGRAM_SIGNAL_CHAT_ID=
AURION_TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated. REQUIRED FOR COMMANDS: empty authorises nobody, so /status, /active
# and the rest are ignored without reply. Alerts still arrive; you just cannot query it.
AURION_TELEGRAM_ALLOWED_USER_IDS=

# --- Macro daily series (free API key from FRED) --------------------------
# Optional today: the runtime constructs an empty MacroCache and no FRED provider is
# wired into it, so the daily macro conditioners are not yet fed live. Leave it blank.
AURION_FRED_API_KEY=

# --- Economic calendar ----------------------------------------------------
# REQUIRED FOR SIGNALS. news.fail_safe is `block`, so with no provider the gate fails closed
# and EVERY signal is suppressed -- correct behaviour, announced once in the admin channel.
# Supported: `file` (a snapshot on disk, see data/README.md) or `none`. An unrecognised name
# is an error rather than a silent fallback to `none`.
AURION_CALENDAR_PROVIDER=file
AURION_CALENDAR_PATH=./data/calendar.json

# --- Runtime --------------------------------------------------------------
AURION_DB_URL=sqlite+aiosqlite:///./data/aurion.sqlite
AURION_CONFIG_PATH=./config.yaml
AURION_LOG_LEVEL=INFO
# Mode is NOT an environment variable: it is `meta.mode` in config.yaml
# (paper | live_alerts | backtest). It changes what the system claims about its own
# output, so it belongs in the versioned config, not in an untracked .env.
